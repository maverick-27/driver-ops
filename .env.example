# Copy to .env and fill in, or run `make env` to generate one with random secrets.
# Nested settings use a DOUBLE underscore (REDIS__PASSWORD). A single underscore is silently ignored.

ENVIRONMENT=development
API_KEY=change-me

# --- Application Postgres ---
POSTGRES_USER=driver_ops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=driver_ops
# Used when running code on the host (tests, eval). Containers get their own URL from compose.yml.
POSTGRES_DATABASE_URL=postgresql+psycopg2://driver_ops:change-me@localhost:5442/driver_ops

# --- LLM (Ollama on the host) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_NUM_CTX=8192

# --- Embeddings: ollama (local), jina (hosted, sends text out), none (BM25 only) ---
EMBEDDINGS__PROVIDER=ollama
EMBEDDINGS__HOST=http://localhost:11434
EMBEDDINGS__MODEL=bge-m3
EMBEDDINGS__JINA_API_KEY=

# --- Search / cache ---
OPENSEARCH__HOST=http://localhost:9200
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=change-me

# --- Airflow ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_SECRET_KEY=change-me

# --- Tracing (Langfuse v3, compose profile "tracing") ---
LANGFUSE__ENABLED=false
LANGFUSE__PUBLIC_KEY=pk-lf-change-me
LANGFUSE__SECRET_KEY=sk-lf-change-me
LANGFUSE__HOST=http://localhost:3001
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=change-me
LANGFUSE_SALT=change-me
# 64 hex characters: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=change-me
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_REDIS_PASSWORD=change-me
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=change-me
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change-me
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me

# --- Telegram bot (compose profile "bot") ---
TELEGRAM__ENABLED=false
TELEGRAM__BOT_TOKEN=
# Comma-separated Telegram user ids of the drivers allowed to use the bot. Empty = nobody.
TELEGRAM__ALLOWED_USER_IDS=
